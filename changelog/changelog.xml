<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet  author="liquibase-1"  id="avinash">
        <tagDatabase  tag="${REQUEST_NUMBER}-${BUILD_NUMBER}"/>
    </changeSet>
    <changeSet id="liquibase-2" author="avinash" runOnChange="true" runWith="sqlplus" >
        <sqlFile path="dbscripts/create_table.sql"/>
    <rollback>
        <sqlFile path="rollback/table_rollback.sql"/>
    </rollback>
    </changeSet>

    <changeSet id="liquibase-3" author="avinash" runOnChange="true">
        <sqlFile path="dbscripts/alter_table.sql"/>
    <rollback>
        <sqlFile path="rollback/alter_table_rollback.sql"/>
    </rollback>
    </changeSet>
</databaseChangeLog>
